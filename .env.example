# =============================================================================
# Configurações de Ambiente - Monorepo Serra do Penitente + MapBiomas API
# =============================================================================
# Copie este arquivo para .env e preencha com seus dados reais
#
# IMPORTANTE:
# - Este arquivo contém configurações para ambos os projetos
# - Mantenha suas credenciais seguras e não commite o arquivo .env
# - Configure todas as variáveis antes de executar os scripts

# =============================================================================
# API MapBiomas Alert - Configuração de Autenticação
# =============================================================================
# Email cadastrado na plataforma MapBiomas Alert
# URL: https://alerta.mapbiomas.org/
# Necessário para: serra-penitente-analysis e mapbiomas-alert-api
MAPBIOMAS_EMAIL=seu_email@exemplo.com

# Senha da conta MapBiomas Alert
MAPBIOMAS_PASSWORD=sua_senha_aqui

# =============================================================================
# Configurações do Pipeline Serra Penitente
# =============================================================================
# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Diretório base para dados (relativo à raiz do projeto)
DATA_DIR=serra-penitente-analysis/data

# Diretório base para resultados (relativo à raiz do projeto)
RESULTS_DIR=results

# Diretório para resultados fixos (relatórios finais)
RESULTADOS_FIXOS_DIR=resultados_fixos

# =============================================================================
# Configurações de API Externa
# =============================================================================
# Timeout para requisições HTTP (em segundos)
API_TIMEOUT=30

# Número máximo de tentativas para requisições
MAX_RETRIES=3

# Intervalo entre tentativas (em segundos)
RETRY_DELAY=2

# =============================================================================
# Configurações do Servidor MapBiomas API
# =============================================================================
# Porta do servidor local (padrão: 8000)
SERVER_PORT=8000

# Host do servidor (padrão: localhost)
SERVER_HOST=localhost

# Modo de desenvolvimento do servidor (true/false)
SERVER_DEBUG=false

# =============================================================================
# Configurações de Processamento
# =============================================================================
# Número de threads para processamento paralelo (opcional)
NUM_THREADS=4

# Tamanho máximo de chunk para processamento de dados grandes (MB)
CHUNK_SIZE_MB=100

# =============================================================================
# Configurações de Desenvolvimento
# =============================================================================
# Modo debug global (true/false)
DEBUG_MODE=false

# Salvar dados intermediários para debug (true/false)
SAVE_INTERMEDIATE_DATA=false

# Diretório para logs (relativo à raiz do projeto)
LOGS_DIR=logs

# =============================================================================
# Configurações de Performance
# =============================================================================
# Tamanho do cache para dados (MB)
CACHE_SIZE_MB=500

# Usar cache de resultados (true/false)
USE_CACHE=true

# =============================================================================
# Configurações de Validação
# =============================================================================
# Executar validação automática de dados (true/false)
AUTO_VALIDATE=true

# Nível de validação (basic, full)
VALIDATION_LEVEL=basic

# =============================================================================
# Notas de Configuração
# =============================================================================
# 1. Nunca commite o arquivo .env com dados reais
# 2. Mantenha suas credenciais seguras
# 3. Para desenvolvimento local, você pode usar dados de teste
# 4. Consulte a documentação da API MapBiomas para obter credenciais:
#    https://alerta.mapbiomas.org/api