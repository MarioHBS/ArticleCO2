# Configurações de Ambiente - Projeto Serra do Penitente
# Copie este arquivo para .env e preencha com seus dados reais

# =============================================================================
# API MapBiomas Alert - Configuração de Autenticação
# =============================================================================
# Email cadastrado na plataforma MapBiomas Alert
# URL: https://alerta.mapbiomas.org/
MAPBIOMAS_EMAIL=seu_email@exemplo.com

# Senha da conta MapBiomas Alert
MAPBIOMAS_PASSWORD=sua_senha_aqui

# =============================================================================
# Configurações do Pipeline
# =============================================================================
# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Diretório base para dados (opcional, padrão: data/)
DATA_DIR=data

# Diretório base para resultados (opcional, padrão: results/)
RESULTS_DIR=results

# =============================================================================
# Configurações de API Externa
# =============================================================================
# Timeout para requisições HTTP (em segundos)
API_TIMEOUT=30

# Número máximo de tentativas para requisições
MAX_RETRIES=3

# =============================================================================
# Configurações de Processamento
# =============================================================================
# Número de threads para processamento paralelo (opcional)
NUM_THREADS=4

# Tamanho máximo de chunk para processamento de dados grandes (MB)
CHUNK_SIZE_MB=100

# =============================================================================
# Configurações de Desenvolvimento
# =============================================================================
# Modo debug (true/false)
DEBUG_MODE=false

# Salvar dados intermediários para debug (true/false)
SAVE_INTERMEDIATE=false

# =============================================================================
# Notas de Configuração
# =============================================================================
# 1. Nunca commite o arquivo .env com dados reais
# 2. Mantenha suas credenciais seguras
# 3. Para desenvolvimento local, você pode usar dados de teste
# 4. Consulte a documentação da API MapBiomas para obter credenciais:
#    https://alerta.mapbiomas.org/api