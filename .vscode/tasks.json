        {
            "label": "🧹 Limpar Arquivos Temporários",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Get-ChildItem -Path . -Recurse -Include '__pycache__', '*.pyc', '.pytest_cache' | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; Write-Host '✅ Arquivos temporários removidos'"
