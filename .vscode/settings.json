{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "python.linting.flake8.enabled": true,
    "python.defaultInterpreterPath": "python",
    "editor.rulers": [
        100
    ],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.encoding": "utf8",
    "files.eol": "\n",
    "python.linting.pylintEnabled": false,
    "python.formatting.blackArgs": [
        "--line-length=100",
        "--target-version=py38"
    ],
    "python.linting.flake8Args": [
        "--max-line-length=100",
        "--extend-ignore=E203,W503"
    ],
    "python.sortImports.args": [
        "--profile=black"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "serra-penitente-analysis/tests",
        "mapbiomas-alert-api/tests"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "python.analysis.extraPaths": [
        "./serra-penitente-analysis",
        "./mapbiomas-alert-api"
    ],
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "files.exclude": {
        ".idea/**": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/logs": true,
        // "serra-penitente-analysis/data/generated": true,
        "serra-penitente-analysis/data/downloads": true,
        // "serra-penitente-analysis/data/archive": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/results": true,
        "**/logs": true,
        "serra-penitente-analysis/data/generated": true,
        "serra-penitente-analysis/data/downloads": true,
        "serra-penitente-analysis/data/archive": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.py": "${capture}.pyc",
        "requirements.txt": "requirements-*.txt",
        ".env.example": ".env",
        "README.md": "*.md"
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "workbench.colorCustomizations": {
        "activityBar.background": "#2D5A27",
        "titleBar.activeBackground": "#3E7B36",
        "titleBar.activeForeground": "#F7FCF6"
    },
    "jupyter.askForKernelRestart": false,
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "git.ignoreLimitWarning": true
}
