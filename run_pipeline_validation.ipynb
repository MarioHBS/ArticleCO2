   "source": [
    "# Função para impressão segura\n",
    "def safe_print(s: str):\n",
    "    try:\n",
    "        print(s)\n",
    "    except UnicodeEncodeError:\n",
    "        clean = s.encode(sys.stdout.encoding, errors='replace').decode(\n",
    "            sys.stdout.encoding)\n",
    "        print(clean)\n",
    "\n",
    "# Função para verificar existência de arquivos\n",
    "def check_files(files):\n",
    "    status = True\n",
    "    print(f\"Verificando {len(files)} arquivo(s):\")\n",
    "    for f in files:\n",
    "        if not os.path.exists(f):\n",
    "            print(f\"[MISSING] {f}\")\n",
    "            status = False\n",
    "        else:\n",
    "            print(f\"[OK]      {f}\")\n",
    "    print(f\"Resultado da verificação: {'SUCESSO' if status else 'FALHOU'}\")\n",
    "    return status\n",
    "\n",
    "# Initialize overall success tracker\n",
    "all_ok = True\n",
    "step_results = []"
   ]
  },
